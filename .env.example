DATABASE_URL=sqlite:///ken_links.db
API_HOST=0.0.0.0
API_PORT=8000

# ── Google Search Console + GA4 ───────────────────────────────────────────────
# Path to the service-account JSON key downloaded from Google Cloud Console.
# The same key is used for both GSC and GA4.
GOOGLE_CREDENTIALS_PATH=

# Search Console property, exactly as shown in GSC:
#   domain property : sc-domain:kenresearch.com
#   URL prefix      : https://www.kenresearch.com/
GSC_SITE_URL=sc-domain:kenresearch.com

# GA4 numeric property ID (GA4 -> Admin -> Property Settings -> PROPERTY ID)
GA4_PROPERTY_ID=

# Lookback windows, in days
GSC_LOOKBACK_DAYS=28
GA4_LOOKBACK_DAYS=28
